    float w1=0.0;
    float w2=0.0;

    //if(k==0){
        if(u[j]<t&&t<=u[j+1]){
            return 1.0;
        }else{
            return 0.0;
        }
    // }else{
    //     if(u[j+k+1]-u[j+1]!=0.0){
    //         w1=GetBasisFunctionFour(u,j+1,k-1,t)*(u[j+k+1]-t)/(u[j+k+1]-u[j+1]);
    //     }

