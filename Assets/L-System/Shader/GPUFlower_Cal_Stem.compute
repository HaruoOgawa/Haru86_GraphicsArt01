#define NUMTHRED_VAL 256

struct StemVertex{
    float3 vertice;
    float3 tangent;
    float3 normal;
    float3 bioNormal;
    int index;
};

//花の数など
struct StemManage{
    int flowerCount;
    int flowerStartIndex;
    int leafCount;
    int leafStartIndex;
};

//花や茎を生成するための情報を載せる構造体
struct StemData{
    int index;
    float3 position;
    float3 tangent;
    float3 normal;
    float3 bioNormal;
};

RWStructuredBuffer<float3> _read_stemBasePosition_buffer;
RWStructuredBuffer<StemVertex> _read_stemResult_buffer;
RWStructuredBuffer<StemVertex> _write_stemResult_buffer;
RWStructuredBuffer<StemVertex> _read_stemVertex_buffer;
RWStructuredBuffer<StemVertex> _write_stemVertex_buffer;
RWStructuredBuffer<StemManage> _read_stemManage_buffer;
RWStructuredBuffer<StemManage> _write_stemManage_buffer;
RWStructuredBuffer<StemData> _read_stemDataFlower_buffer;
RWStructuredBuffer<StemData> _write_stemDataFlower_buffer;
RWStructuredBuffer<StemData> _read_stemDataLeaf_buffer;
RWStructuredBuffer<StemData> _write_stemDataLeaf_buffer;

RWStructuredBuffer<float4x4> _write_stem_debug_bufer;

int _contPosArrayLength;
float4 _controlPoints[6];
float _knotMin;
float _knotMax;
float _tWidth;
int _stemVertexCount;

float GetBasisFunctionFour(float u[10],int j,int k,float t){
    float w1=0.0;
    float w2=0.0;

    if(u[j]<t&&t<=u[j+1]){
        return 1.0;
    }else{
        return 0.0;
    }
    
}

