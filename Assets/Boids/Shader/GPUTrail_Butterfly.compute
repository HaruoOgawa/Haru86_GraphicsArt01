#pragma kernel NextInputPos
#pragma kernel NodeInfo

struct Butterfly{
    float3 position;
    float3 velocity;
};

struct trail{
    int nextCalNodeIndex;
    int leftSideFirst;
    int rightSideFirst;
    int rightSideSecond;
    float4 trail_color;
};

struct node{
    float3 node_position;
    float node_life;
    int renderFlag;
};

 struct input_data{
    float3 nextInputPosition;
};

RWStructuredBuffer<Butterfly> _boids_data_read;

RWStructuredBuffer<input_data> _input_data_read;
RWStructuredBuffer<input_data> _input_data_write;
RWStructuredBuffer<trail> _trailIndexData_read;
RWStructuredBuffer<trail> _trailIndexData_write;
RWStructuredBuffer<node> _node_data_read;
RWStructuredBuffer<node> _node_data_write;


// RWStructuredBuffer<float4x4> _debug_buffer_node_position;

int _nodeSegment;
float _nodeDistanceMin;
float _DTime;
float _initNodeLife;

[numthreads(256,1,1)]
void NextInputPos(
    uint3 DID : SV_DISPATCHTHREADID
){
    _input_data_write[DID.x].nextInputPosition=_boids_data_read[DID.x].position;
}

[numthreads(256,1,1)]
void NodeInfo(
    uint3 DID : SV_DISPATCHTHREADID
){
    int trailIndex=(int)DID.x;
    trail trail_data=_trailIndexData_read[trailIndex];
    input_data input_next_data=_input_data_read[trailIndex];
    int nowCalNodeIndex=trail_data.nextCalNodeIndex;
    int myNodeIndex=trailIndex*_nodeSegment+nowCalNodeIndex;
    node node_data=_node_data_read[myNodeIndex];
    float node_life=node_data.node_life;

    float calNodeLength=length(input_next_data.nextInputPosition-node_data.node_position);

    if(calNodeLength>=_nodeDistanceMin){
       
    
        //  node_data.node_life+=(node_data.node_life<=0.0) ? _initNodeLife : 0
        //cal node
        node_data.renderFlag++;
        node_data.node_position=input_next_data.nextInputPosition;
        node_life-=_DTime;
        //node_life=node_life%_initNodeLife;
        node_life=(node_life<=0.0) ? _initNodeLife : node_life;
        node_data.node_life=node_life;
        //cal trail
        int leftSideFirst=nowCalNodeIndex;
        int rightSideFirst=(nowCalNodeIndex+(_nodeSegment-1))%_nodeSegment;
        int rightSideSecond=(nowCalNodeIndex+(_nodeSegment-2))%_nodeSegment;

        //  //debug
        //  float4x4 debug_matrix=float4x4(
        //     float4(nowCalNodeIndex,leftSideFirst,rightSideFirst,rightSideSecond),
        //     float4(myNodeIndex,trailIndex,nowCalNodeIndex,0),
        //     float4(0.,0.,0.,0.),
        //     float4(0.,0.,0,0.)
            
        // );
        // _debug_buffer_node_position[trailIndex]=debug_matrix;
        // //debug end

        nowCalNodeIndex++;
        nowCalNodeIndex=(uint)nowCalNodeIndex%_nodeSegment;
        trail_data.nextCalNodeIndex=nowCalNodeIndex;
        trail_data.leftSideFirst=leftSideFirst;
        trail_data.rightSideFirst=rightSideFirst;
        trail_data.rightSideSecond=rightSideSecond;

        //write to buffer
        _node_data_read[myNodeIndex]=node_data;
        _trailIndexData_read[trailIndex]=trail_data;


          
       

    }   
}




